# Copy this file to `.streamlit/secrets.toml` (or paste keys in Streamlit Cloud Secrets UI).

GADOURA_DRIVE_SYNC = "1"
GADOURA_DRIVE_FOLDER_ID = "PUT_YOUR_DRIVE_FOLDER_ID_HERE"
GADOURA_DRIVE_TOP_FOLDERS = "field data,satellite data"
GADOURA_DRIVE_SYNC_INTERVAL_MINUTES = "30"
GADOURA_LOCAL_MIRROR_ROOT = "/tmp/gadoura"

# Paste full service-account JSON as one line (escaped quotes) or multiline string.
# Example with multiline TOML literal:
GADOURA_DRIVE_SERVICE_ACCOUNT_JSON = """
{
  "type": "service_account",
  "project_id": "your-project-id",
  "private_key_id": "your-private-key-id",
  "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",
  "client_email": "your-service-account@your-project-id.iam.gserviceaccount.com",
  "client_id": "your-client-id",
  "auth_uri": "https://accounts.google.com/o/oauth2/auth",
  "token_uri": "https://oauth2.googleapis.com/token",
  "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
  "client_x509_cert_url": "https://www.googleapis.com/robot/v1/metadata/x509/..."
}
"""
